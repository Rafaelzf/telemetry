{
  "name": "telemetry-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Web Monitoring Telemetry Backend - Ingestion Engine & API",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/database/migrate.ts latest",
    "migrate:rollback": "tsx src/database/migrate.ts rollback",
    "migrate:status": "tsx src/database/migrate.ts status"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
