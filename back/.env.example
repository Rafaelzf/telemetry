# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# CORS - comma-separated list of allowed origins, or * for any
CORS_ORIGIN=*

# PostgreSQL connection string. For Supabase, use the "Session pooler" string
# from Project Settings > Database > Connection string (IPv4-compatible,
# port 5432, works well for a persistent server with its own pool).
# Format: postgres://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/telemetry

# Upstash Redis REST API - from the "REST API" tab in the console's Details
# page. Works over HTTPS/443, used for the ingestion queue, rate limiting,
# and metrics caching. No TCP (6379) connection is used, since that port is
# blocked on some networks (corporate DPI firewalls).
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# Ingestion limits (DoS protection)
MAX_PAYLOAD_BYTES=1048576
BATCH_MAX_EVENTS=500

# Ingestion queue (Redis-list-backed, polled over the REST API above).
# Each concurrent loop polls Redis even when the queue is empty, so
# QUEUE_CONCURRENCY x (1000 / QUEUE_POLL_INTERVAL_MS) is your baseline idle
# request rate against Redis. These defaults (1 x every 60s = ~1,440 req/day)
# are tuned to stay well under Upstash's free-plan 10,000 requests/day cap.
# Only lower the interval / raise concurrency on a paid Redis plan.
QUEUE_CONCURRENCY=1
QUEUE_MAX_SIZE=10000
QUEUE_POLL_INTERVAL_MS=60000

# Per-IP sliding-window rate limit on POST /telemetry
INGEST_RATE_LIMIT_MAX=100
INGEST_RATE_LIMIT_WINDOW_SECONDS=60

# TTL for cached /metrics query results
METRICS_CACHE_TTL_SECONDS=30
